# Dataset cache — too large to commit (LongMemEval-S is ~278MB,
# LongMemEval-M is 2.75GB). Rehydrate via `agentos-bench setup`.
data/

# Local build output
dist/
node_modules/
*.tsbuildinfo

# OS junk
.DS_Store

# Vendor reproduction adapters' Python venvs (sentence-transformers + deps
# can be 800MB+; users recreate via the wrapper script's `python -m venv`).
vendors/*/.venv/
vendors/*/__pycache__/
vendors/*/*.pyc

# Internal research artifacts (vibe-coded session docs, never push).
# Anything date-stamped or stage-tagged is transient working notes;
# only the curated top-level docs (README, SCORECARD, PROVENANCE, etc.)
# belong in git.
.superpowers/
docs/superpowers/
docs/specs/
docs/plans/
docs/STEP_*_FINDINGS_*.md
docs/RAG_STACK_*.md
docs/PHASE_*.md
docs/STAGE_*.md
docs/SESSION_*.md
docs/SOTA_*.md
docs/ARCHITECTURE_DECISION_*.md
docs/COMPETITOR_*.md
docs/INDUSTRY_*.md
docs/RESEARCH_FOLLOWUP*.md
docs/RETRIEVAL_CONFIG_*.md
docs/*_2026-*.md
docs/*_2027-*.md
